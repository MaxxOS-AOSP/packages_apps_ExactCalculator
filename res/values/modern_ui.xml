<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="BottomNavItem" parent="Widget.Material3Expressive.Button.TextButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginHorizontal">2dp</item>
        <item name="android:paddingTop">5dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:paddingStart">2dp</item>
        <item name="android:paddingEnd">2dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:gravity">center</item>
        <item name="iconSize">22dp</item>
        <item name="iconPadding">2dp</item>
        <item name="android:minWidth">0dp</item>
