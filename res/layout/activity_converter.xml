<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/converter_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            
            android:contentDescription="@string/nav_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="8dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/converter_title"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/converter_subtitle"
                android:textSize="14sp"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/converter_categories"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/category_length"
            style="@style/ConverterCategoryButton"
            android:text="@string/category_length" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/category_weight"
            style="@style/ConverterCategoryButton"
            android:text="@string/category_weight" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/category_temperature"
            style="@style/ConverterCategoryButton"
            android:text="@string/category_temperature" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:cardCornerRadius="28dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
        xmlns:app="http://schemas.android.com/apk/res-auto">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/converter_from"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <EditText
                android:id="@+id/converter_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:inputType="numberDecimal|numberSigned"
                android:text="1"
                android:textSize="34sp"
                android:gravity="end"
                android:background="@null"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/converter_from_unit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Kilometer (km)"
                android:gravity="end"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/converter_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="0.621371 mi"
                android:textSize="30sp"
                android:gravity="end"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/converter_to_unit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mile (mi)"
                android:gravity="end"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
