<?xml version="1.0" encoding="utf-8"?>
<!--
     iOS-style history bottom sheet. Reference-style frosted blur: the
     keypad behind is blurred via RenderEffect (see Calculator) and this
     sheet draws a translucent frosted fill over it.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:clipChildren="false">

    <FrameLayout
        android:id="@+id/history_sheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="bottom"
        android:layout_marginTop="150dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/history_sheet_edge"
        android:clipToOutline="true"
        android:clipChildren="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <View
                android:layout_width="36dp"
                android:layout_height="5dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/history_grabber" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/title_history"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="?attr/calculatorResultTextColor" />

                <TextView
                    android:id="@+id/history_clear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="@string/menu_clear_history"
                    android:textSize="16sp"
                    android:textColor="?attr/iosOperatorBackground" />

                <TextView
                    android:id="@+id/history_close"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/history_close_circle"
                    android:gravity="center"
                    android:text="✕"
                    android:textSize="16sp"
                    android:textColor="?attr/calculatorResultTextColor" />

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/history_recycler_view"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:paddingBottom="@dimen/history_divider_padding"
                app:layoutManager="LinearLayoutManager"
                app:reverseLayout="true" />

        </LinearLayout>

    </FrameLayout>

</FrameLayout>
