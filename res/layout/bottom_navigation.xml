<?xml version="1.0" encoding="utf-8"?>
<com.android.calculator2.LiquidGlassBottomBar xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bottom_navigation"
    android:layout_width="wrap_content"
    android:layout_height="64dp"
    android:elevation="10dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <LinearLayout
        android:id="@+id/nav_tabs"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/nav_calculator"
            style="@style/BottomNavItem"
            android:contentDescription="@string/nav_calculator"
            android:text="@string/nav_calculator"
            android:drawableTop="@drawable/ic_nav_calculator" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/nav_history"
            style="@style/BottomNavItem"
            android:contentDescription="@string/nav_history"
            android:text="@string/nav_history"
            android:drawableTop="@drawable/ic_nav_history" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/nav_converter"
            style="@style/BottomNavItem"
            android:contentDescription="@string/nav_converter"
            android:text="@string/nav_converter"
            android:drawableTop="@drawable/ic_nav_converter" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/nav_settings"
            style="@style/BottomNavItem"
            android:contentDescription="@string/nav_settings"
            android:text="@string/nav_settings"
            android:drawableTop="@drawable/ic_nav_settings" />

    </LinearLayout>

</com.android.calculator2.LiquidGlassBottomBar>
